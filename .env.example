# Copy to .env and fill in. .env is gitignored.
#
# Web console account for the local Apache Sling instance. scripts/deploy-to-sling.sh
# and the sling-maven-plugin read these names. The apache/sling image creates
# the initial account; this repository does not store the password.
# Do not commit real values.

SLING_ADMIN_USER=
SLING_ADMIN_PASSWORD=

# Optional. Deploy posts to ${SLING_URL}/system/console.
# SLING_URL=http://localhost:8080

# Optional. Cache flush listener (localhost only; not port 80).
# DISPATCHER_URL=http://127.0.0.1:8081
